{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-synced"
  ],
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "cargo *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "git *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "cat *": "allow"
    },
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "agent": {
    "reviewer": {
      "model": "moonshotai/kimi-k2.6",
      "mode": "subagent"
    },
    "tester": {
      "model": "moonshotai/kimi-k2.6",
      "mode": "subagent"
    }
  }
}
