{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main, dashboard and overlay windows.",
  "windows": ["main", "dashboard-window", "overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-set-focus",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-close",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "shell:default"
  ]
}
